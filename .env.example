# Postgres 密码（仅本地开发用，上线必须换随机值：openssl rand -hex 24）
POSTGRES_PASSWORD=logto_dev_7c41f2

# Logto 对外地址。issuer 就是 ${LOGTO_ENDPOINT}/oidc，业务侧必须用这个值
# 本地开发：http://localhost:3001 / http://localhost:3002
# 生产（经 mcp-agent 的 Caddy 反代，自动 HTTPS）：LOGTO_ENDPOINT 与 LOGTO_ADMIN_ENDPOINT
# 必须和部署 .env 里的 AUTH_SITE_ADDRESS / AUTH_ADMIN_SITE_ADDRESS 完全一致，例如
#   LOGTO_ENDPOINT=https://auth.1-2-3-4.sslip.io
#   LOGTO_ADMIN_ENDPOINT=https://admin.1-2-3-4.sslip.io
# 注意：这两个值在首次启动时写入数据库，之后改值必须重新初始化 Logto 数据卷或走迁移。
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# 用于跑 provision.mjs 的机器身份（在管理后台创建后填入）
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=

# SPA 回调来源（provision 只在“应用尚不存在”时写入，改值后需在控制台同步改或删应用重建）
# 生产改成 https://mcp.1-2-3-4.sslip.io（即部署 .env 的 SITE_ADDRESS）
MCP_WEB_ORIGIN=http://localhost:5173
AI_WEB_ORIGIN=http://localhost:5174
