# Postgres 密码（仅本地开发用，上线必须换随机值）
POSTGRES_PASSWORD=logto_dev_7c41f2

# Logto 对外地址。issuer 就是 ${LOGTO_ENDPOINT}/oidc，业务侧必须用这个值
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# 用于跑 provision.mjs 的机器身份（在管理后台创建后填入）
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=

# SPA 回调来源（provision 只在“应用尚不存在”时写入，改值后需在控制台同步改或删应用重建）
MCP_WEB_ORIGIN=http://localhost:5173
AI_WEB_ORIGIN=http://localhost:5174
